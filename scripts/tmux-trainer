#!/usr/bin/env bash
set -euo pipefail

_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
ROOT_DIR="$(cd "$(dirname "$_src")/.." && pwd)"
unset _src _dir
EXERCISE_DIR="${ROOT_DIR}/exercises"
LOG_DIR="${HOME}/.local/share/tmux-trainer"

TOTAL_EXERCISES=$(ls "${EXERCISE_DIR}"/day-*.md 2>/dev/null | wc -l | tr -d ' ')

SRS_INTERVALS=(1 3 7 21)

# ── user config ────────────────────────────────────────────────────────────
WEBHOOK_URL=""
_conf="${HOME}/.config/tmux-trainer/conf"
[[ -f "${_conf}" ]] && source "${_conf}"
unset _conf
# Recalculate derived paths (user config may override LOG_DIR)
LOG_FILE="${LOG_DIR}/log"
SRS_FILE="${LOG_DIR}/srs"
CURRENT_FILE="${LOG_DIR}/current"

# ── display style (NO_COLOR / narrow terminal) ─────────────────────────────
_cols="$(tput cols 2>/dev/null || echo 80)"
if [[ -n "${NO_COLOR:-}" ]] || [[ "${_cols}" -lt 60 ]]; then
  IC_FIRE=">"; IC_BOOKS=">"; IC_WARN="!"
  IC_CHECK="+"; IC_CROSS="-"; IC_DICE="~"; IC_TIMER="~"
  IC_BADGE="*"; _NARROW=1
else
  IC_FIRE="🔥"; IC_BOOKS="📚"; IC_WARN="⚠ "
  IC_CHECK="✓"; IC_CROSS="✗"; IC_DICE="🎲"; IC_TIMER="⏱ "
  IC_BADGE="🏅"; _NARROW=0
fi
unset _cols

# ── portable date helpers ──────────────────────────────────────────────────

_today() { date +%Y-%m-%d; }

_date_dow() {  # day-of-week for a YYYY-MM-DD string; 1=Mon … 7=Sun
  if date --version >/dev/null 2>&1; then
    date -d "$1" +%u
  else
    date -jf "%Y-%m-%d" "$1" +%u
  fi
}

_date_sub() {  # subtract N days from YYYY-MM-DD
  local d="$1" n="$2"
  if date --version >/dev/null 2>&1; then
    date -d "${d} - ${n} days" +%Y-%m-%d
  else
    date -jf "%Y-%m-%d" -v-${n}d "${d}" +%Y-%m-%d
  fi
}

_date_add() {  # add N days to YYYY-MM-DD
  local d="$1" n="$2"
  if date --version >/dev/null 2>&1; then
    date -d "${d} + ${n} days" +%Y-%m-%d
  else
    date -jf "%Y-%m-%d" -v+${n}d "${d}" +%Y-%m-%d
  fi
}

# ── exercise selection ─────────────────────────────────────────────────────

_current_day() {
  local week dow
  week="$(date +%V)"
  dow="$(date +%u)"
  [[ "${dow}" -gt 5 ]] && dow=1
  echo $(( ( (week - 1) * 5 + dow - 1 ) % TOTAL_EXERCISES + 1 ))
}

# ── state file ─────────────────────────────────────────────────────────────

_ensure_log() { mkdir -p "${LOG_DIR}"; }

_log_append() {  # _log_append DATE FIELD STATUS
  _ensure_log
  echo "$1 $2 $3" >> "${LOG_FILE}"
}

_today_status() {  # optional: _today_status PAD — scope to a specific exercise
  local pad="${1:-}"
  [[ -f "${LOG_FILE}" ]] || { echo "none"; return; }
  local last pattern
  if [[ -n "${pad}" ]]; then
    pattern="^$(_today) ${pad} "
  else
    pattern="^$(_today) "
  fi
  last="$(grep "${pattern}" "${LOG_FILE}" | tail -1)" || true
  if   [[ "${last}" == *"completed"* ]]; then echo "completed"
  elif [[ "${last}" == *"skipped"*   ]]; then echo "skipped"
  else                                         echo "none"
  fi
}

# ── streak ─────────────────────────────────────────────────────────────────

_streak() {
  [[ -f "${LOG_FILE}" ]] || { echo 0; return; }
  local streak=0 check
  check="$(_today)"
  for (( i=0; i<200; i++ )); do
    local dow
    dow="$(_date_dow "${check}")"
    if [[ "${dow}" -le 5 ]]; then
      if grep -q "^${check} .* completed$" "${LOG_FILE}" 2>/dev/null; then
        (( streak++ )) || true
      else
        break
      fi
    fi
    check="$(_date_sub "${check}" 1)"
  done
  echo "${streak}"
}

# ── week progress ──────────────────────────────────────────────────────────

_week_anchor() {
  # Prints: ANCHOR DAYS_TO_SHOW
  # ANCHOR = today (weekday) or last Friday (weekend)
  local anchor dow_now days_to_show
  anchor="$(_today)"
  dow_now="$(date +%u)"
  if [[ "${dow_now}" -gt 5 ]]; then
    anchor="$(_date_sub "${anchor}" $(( dow_now - 5 )))"
    days_to_show=5
  else
    days_to_show="${dow_now}"
  fi
  echo "${anchor} ${days_to_show}"
}

_week_completed_count() {
  read -r anchor days_to_show <<< "$(_week_anchor)"
  local completed=0
  for (( d=1; d<=days_to_show; d++ )); do
    local days_back=$(( days_to_show - d )) check_date
    [[ "${days_back}" -eq 0 ]] && check_date="${anchor}" \
                                || check_date="$(_date_sub "${anchor}" "${days_back}")"
    [[ -f "${LOG_FILE}" ]] \
      && grep -q "^${check_date} .* completed$" "${LOG_FILE}" 2>/dev/null \
      && (( completed++ )) || true
  done
  echo "${completed}"
}

_week_bar() {
  local completed bar=""
  completed="$(_week_completed_count)"
  for (( i=1; i<=5; i++ )); do
    [[ $i -le $completed ]] && bar+="█" || bar+="░"
  done
  printf "[%s] %d/5 this week" "${bar}" "${completed}"
}

# ── milestone badges ───────────────────────────────────────────────────────

_check_badges() {
  # first-done: first ever completion
  if ! grep -q " badge first-done$" "${LOG_FILE}" 2>/dev/null; then
    _log_append "$(_today)" "badge" "first-done"
    printf "%s Badge unlocked: First completion\n" "${IC_BADGE}"
  fi

  # first-week: first time all 5 weekdays completed in a single week
  if ! grep -q " badge first-week$" "${LOG_FILE}" 2>/dev/null; then
    if [[ "$(_week_completed_count)" -ge 5 ]]; then
      _log_append "$(_today)" "badge" "first-week"
      printf "%s Badge unlocked: First full week\n" "${IC_BADGE}"
    fi
  fi

  # first-cycle: every exercise completed at least once
  if ! grep -q " badge first-cycle$" "${LOG_FILE}" 2>/dev/null; then
    local all_done=1
    for (( n=1; n<=TOTAL_EXERCISES; n++ )); do
      local p; printf -v p "%02d" "${n}"
      if ! grep -q "^.* ${p} completed$" "${LOG_FILE}" 2>/dev/null; then
        all_done=0; break
      fi
    done
    if [[ "${all_done}" -eq 1 ]]; then
      _log_append "$(_today)" "badge" "first-cycle"
      printf "%s Badge unlocked: First full cycle — all %d exercises done!\n" \
        "${IC_BADGE}" "${TOTAL_EXERCISES}"
    fi
  fi
}

# ── spaced repetition (SM-2) ──────────────────────────────────────────────
# SRS_FILE: tab-separated, one line per exercise: PAD<TAB>LAST_DATE<TAB>REPS
# REPS = consecutive correct recalls. Interval = SRS_INTERVALS[min(reps,3)].
# Only exercises explicitly skipped enter the queue; done advances them.

_srs_update() {  # _srs_update PAD CORRECT(1=pass,0=fail)
  local pad="$1" correct="$2"
  _ensure_log

  local existing_reps=""
  [[ -f "${SRS_FILE}" ]] \
    && existing_reps="$(awk -v p="${pad}" '$1==p{print $3}' "${SRS_FILE}")"

  # Correct recall on an exercise not yet in the queue: nothing to track
  [[ "${correct}" -eq 1 && -z "${existing_reps}" ]] && return

  local reps="${existing_reps:-0}"
  if [[ "${correct}" -eq 1 ]]; then
    [[ "${reps}" -lt 3 ]] && reps=$(( reps + 1 )) || true
  else
    reps=0
  fi

  local today; today="$(_today)"
  local tmp; tmp="$(mktemp)"

  if [[ -n "${existing_reps}" && -f "${SRS_FILE}" ]]; then
    awk -v p="${pad}" -v d="${today}" -v r="${reps}" \
      '$1==p{print p"\t"d"\t"r; next} {print}' "${SRS_FILE}" > "${tmp}"
  else
    [[ -f "${SRS_FILE}" ]] && cat "${SRS_FILE}" > "${tmp}" || true
    printf "%s\t%s\t%s\n" "${pad}" "${today}" "${reps}" >> "${tmp}"
  fi
  mv "${tmp}" "${SRS_FILE}"
}

_srs_due_list() {  # prints zero-padded exercise numbers due today, oldest first
  [[ -f "${SRS_FILE}" ]] || return 0
  local today; today="$(_today)"
  while IFS=$'\t' read -r pad last_date reps; do
    local idx interval due_date
    idx=$(( reps < 4 ? reps : 3 ))
    interval="${SRS_INTERVALS[${idx}]}"
    due_date="$(_date_add "${last_date}" "${interval}")"
    [[ "${due_date}" < "${today}" || "${due_date}" == "${today}" ]] \
      && printf "%s %s\n" "${pad}" "${due_date}"
  done < "${SRS_FILE}" | sort -k2 | awk '{print $1}'
}

_srs_reviews_pending() {
  _srs_due_list | wc -l | tr -d ' '
}

# ── assertion engine (used by check subcommand) ───────────────────────────

_assert() {
  local type="$1" pass=0 msg=""
  shift
  case "${type}" in
    session_exists)
      if tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -qx "$1"; then
        pass=1; msg="session '$1' exists"
      else
        msg="session '$1' not found"
      fi
      ;;
    window_count)
      local actual
      actual="$(tmux list-windows -t "$1" 2>/dev/null | wc -l | tr -d ' ')" || actual=0
      if [[ "${actual}" -eq "$2" ]]; then
        pass=1; msg="'$1' has ${actual} window(s)"
      else
        msg="'$1' has ${actual} window(s), expected $2"
      fi
      ;;
    window_named)
      if tmux list-windows -t "$1" -F '#{window_name}' 2>/dev/null | grep -qx "$2"; then
        pass=1; msg="window '$2' found in '$1'"
      else
        msg="window '$2' not found in '$1'"
      fi
      ;;
    pane_count)
      local actual
      actual="$(tmux list-panes -t "$1" 2>/dev/null | wc -l | tr -d ' ')" || actual=0
      if [[ "${actual}" -eq "$2" ]]; then
        pass=1; msg="'$1' has ${actual} pane(s)"
      else
        msg="'$1' has ${actual} pane(s), expected $2"
      fi
      ;;
    pane_running)
      local actual
      actual="$(tmux display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null)" \
        || actual=""
      if [[ "${actual}" == "$2" ]]; then
        pass=1; msg="'$1' is running '$2'"
      else
        msg="'$1' running '${actual}', expected '$2'"
      fi
      ;;
    option_set)
      local actual
      actual="$(tmux show-options -gv "$1" 2>/dev/null)" || actual=""
      if [[ "${actual}" == "$2" ]]; then
        pass=1; msg="$1 = $2"
      else
        msg="$1 = '${actual}', expected '$2'"
      fi
      ;;
    file_exists)
      local path="${1/#\~/${HOME}}"
      if [[ -f "${path}" ]]; then
        pass=1; msg="file exists: ${path}"
      else
        msg="file not found: ${path}"
      fi
      ;;
    pane_contains)
      local content
      content="$(tmux capture-pane -t "$1" -p -S - 2>/dev/null)" || content=""
      if echo "${content}" | grep -q "$2"; then
        pass=1; msg="'$1' contains '$2'"
      else
        msg="'$1' does not contain '$2'"
      fi
      ;;
    file_contains)
      local path="${1/#\~/${HOME}}"
      if [[ -f "${path}" ]] && grep -q "$2" "${path}" 2>/dev/null; then
        pass=1; msg="'${path}' contains '$2'"
      else
        msg="'${path}' does not contain '$2'"
      fi
      ;;
    *)
      msg="unknown assertion type: ${type}"
      ;;
  esac

  if [[ "${pass}" -eq 1 ]]; then
    printf "  %s %s\n" "${IC_CHECK}" "${msg}"
  else
    printf "  %s %s\n" "${IC_CROSS}" "${msg}"
    return 1
  fi
}

# ── subcommand alias normalisation ────────────────────────────────────────
case "${1:-}" in
  r)             set -- review ;;
  m)             set -- menu ;;
  d)             set -- done ;;
  s)             set -- skip "${@:2}" ;;
  c)             set -- check "${@:2}" ;;
  h|-h|--help)   set -- help ;;
esac

# ── internal: generate man page (troff) ───────────────────────────────────

_generate_man() {
  cat <<'TROFF'
.TH TMUX-TRAINER 1 "" "tmux-trainer" "User Commands"
.SH NAME
tmux\-trainer \- daily tmux exercise trainer
.SH SYNOPSIS
.B tmux-trainer
.RI [ DAY ]
.br
.B tmux-trainer
.I subcommand
.RI [ args ]
.SH DESCRIPTION
Delivers one tmux exercise per working day.
Tracks completions, streaks, and spaced-repetition reviews.
Run without arguments to get today's exercise
(or the next SRS review if one is due).
.SH SUBCOMMANDS
.TP
.B (no args)
Today's exercise \(em SRS queue first.
.TP
.B DAY
Open a specific exercise by number (1\-24).
.TP
.BR menu " | " m
Pick any exercise with fzf. Falls back to shell
.I select
if fzf is not installed.
.TP
.BR done " | " d
Mark the current exercise completed and advance its SRS interval.
Running
.B done
twice on the same day is a no-op.
.TP
.BR "skip [N]" " | " "s [N]"
Defer the current (or specified) exercise to the SRS queue.
.TP
.BR "check [N]" " | " "c [N]"
Verify your live tmux state against the exercise assertions.
Pass a day number to check a specific exercise.
Assertion types: session_exists, window_count, window_named,
pane_count, pane_running, option_set, file_exists,
pane_contains, file_contains.
.TP
.B cheat
Print all Ctrl-b shortcuts introduced up to today's exercise.
.TP
.B "cheat \-\-all"
Print shortcuts from all 24 exercises.
.TP
.BR review " | " r
Open a random completed exercise as an unscheduled drill.
.TP
.BR help " | " h
Print a usage summary to stdout.
.SH FILES
.TP
.I ~/.local/share/tmux-trainer/log
Append-only completion log. One entry per run.
.TP
.I ~/.local/share/tmux-trainer/srs
Spaced-repetition queue state (tab-separated).
.TP
.I ~/.local/share/tmux-trainer/current
Last opened exercise number.
.TP
.I /tmp/tmux-trainer-day-NN.md
Annotatable working copy of the current exercise.
.SH TMUX KEYBINDING
Trigger a random drill from any tmux window with Prefix+r.
Add to
.IR ~/.tmux.conf :
.PP
.nf
    bind-key r run-shell "tmux-trainer review"
.fi
.SH EXAMPLES
.nf
tmux-trainer          # today's exercise
tmux-trainer 7        # exercise 7
tmux-trainer m        # pick with fzf
tmux-trainer d        # mark complete
tmux-trainer c        # verify tmux state
tmux-trainer cheat    # shortcut reference
tmux-trainer r        # random drill
.fi
.SH AUTHOR
Written by DiBDV. Source: https://github.com/DiBDV/tmux-trainer
TROFF
}

if [[ "${1:-}" == "--man-install" ]]; then
  MAN_DIR="${HOME}/.local/share/man/man1"
  mkdir -p "${MAN_DIR}"
  _generate_man > "${MAN_DIR}/tmux-trainer.1"
  echo "man page installed → ${MAN_DIR}/tmux-trainer.1"
  exit 0
fi

# ── subcommand: help ───────────────────────────────────────────────────────

if [[ "${1:-}" == "help" ]]; then
  cat <<'MANPAGE'

NAME
    tmux-trainer — daily tmux exercise trainer

SYNOPSIS
    tmux-trainer [DAY]
    tmux-trainer <subcommand> [args]

DESCRIPTION
    Delivers one tmux exercise per working day. Tracks completions,
    streaks, and spaced-repetition reviews. Run without arguments to
    get today's exercise (or the next SRS review if one is due).

SUBCOMMANDS
    (no args)        today's exercise — SRS queue first
    DAY              specific exercise by number (1–24)
    menu    | m      pick any exercise with fzf
    done    | d      mark current exercise completed
    skip    | s      defer current exercise to SRS queue
    skip N  | s N    defer a specific exercise
    check   | c      verify your live tmux state
    check N | c N    verify a specific day's state
    cheat            shortcuts introduced up to today
    cheat --all      shortcuts from all exercises
    review  | r      open a random completed exercise as a drill
    help    | h      show this page
    --tag NAME       filter exercises by tag and pick with fzf

FILES
    ~/.local/share/tmux-trainer/log      completion log
    ~/.local/share/tmux-trainer/srs      SRS queue state
    ~/.local/share/tmux-trainer/current  last opened exercise
    /tmp/tmux-trainer-day-NN.md          annotatable working copy

TMUX KEYBINDING
    Trigger a random drill from any tmux window with Prefix+r.
    Add to ~/.tmux.conf:

        bind-key r run-shell "tmux-trainer review"

EXAMPLES
    tmux-trainer              today's exercise
    tmux-trainer 7            exercise 7
    tmux-trainer m            pick with fzf
    tmux-trainer d            mark complete
    tmux-trainer c            verify tmux state
    tmux-trainer cheat        shortcut reference
    tmux-trainer r            random drill
    tmux-trainer --tag config all config exercises

MANPAGE
  exit 0
fi

# ── subcommand: review ─────────────────────────────────────────────────────

if [[ "${1:-}" == "review" ]]; then
  if [[ ! -f "${LOG_FILE}" ]]; then
    echo "No completed exercises yet — finish one first." >&2
    exit 0
  fi

  mapfile -t _completed < <(
    awk '/completed$/ {print $2}' "${LOG_FILE}" | sort -u
  )

  if [[ ${#_completed[@]} -eq 0 ]]; then
    echo "No completed exercises yet — finish one first." >&2
    exit 0
  fi

  _pick="${_completed[$(( RANDOM % ${#_completed[@]} ))]}"
  printf "%s Random drill: Day %s\n\n" "${IC_DICE}" "${_pick}"
  exec "$0" "$(( 10#${_pick} ))"
fi

# ── subcommand: check ──────────────────────────────────────────────────────

if [[ "${1:-}" == "check" ]]; then
  if [[ -n "${2:-}" ]] && [[ "${2}" =~ ^[0-9]+$ ]]; then
    CHECK_DAY="${2}"
  else
    CHECK_DAY="$(_current_day)"
  fi
  printf -v CHECK_PAD "%02d" "${CHECK_DAY}"
  CHECK_FILE="${EXERCISE_DIR}/day-${CHECK_PAD}.md"

  if [[ ! -f "${CHECK_FILE}" ]]; then
    echo "Exercise not found: ${CHECK_FILE}" >&2; exit 1
  fi

  CHECK_TITLE="$(grep -m1 '^# ' "${CHECK_FILE}" | sed 's/^# //')"

  # Extract assertions from the ```text block inside ## Check section
  CHECK_ASSERTIONS="$(awk '
    /^## Check$/    { sec=1; next }
    /^## /          { sec=0; blk=0; next }
    sec && /^```text/ { blk=1; next }
    sec && /^```/   { blk=0; next }
    sec && blk && NF { print }
  ' "${CHECK_FILE}")"

  if [[ -z "${CHECK_ASSERTIONS}" ]]; then
    echo "No check defined for: ${CHECK_TITLE}"
    exit 0
  fi

  echo
  echo "Checking: ${CHECK_TITLE}"
  echo

  chk_pass=0; chk_fail=0
  while IFS= read -r chk_line; do
    [[ -z "${chk_line}" ]] && continue
    # shellcheck disable=SC2086
    if _assert ${chk_line}; then
      (( chk_pass++ )) || true
    else
      (( chk_fail++ )) || true
    fi
  done <<< "${CHECK_ASSERTIONS}"

  echo
  if [[ "${chk_fail}" -eq 0 ]]; then
    printf "All %d checks passed ✓\n" "${chk_pass}"
  else
    printf "%d/%d checks passed\n" "${chk_pass}" "$(( chk_pass + chk_fail ))"
    exit 1
  fi
  exit 0
fi

# ── subcommand: cheat ─────────────────────────────────────────────────────

if [[ "${1:-}" == "cheat" ]]; then
  [[ "${2:-}" == "--all" ]] && MAX_DAY="${TOTAL_EXERCISES}" \
                             || MAX_DAY="$(_current_day)"
  echo
  printf "=== tmux cheat sheet (days 1–%d) ===\n" "${MAX_DAY}"

  for (( n=1; n<=MAX_DAY; n++ )); do
    local_p=""; printf -v local_p "%02d" "${n}"
    local_f="${EXERCISE_DIR}/day-${local_p}.md"
    [[ -f "${local_f}" ]] || continue

    title="$(grep -m1 '^# ' "${local_f}" | sed 's/^# //')"

    # Extract lines from ```text blocks that start with Ctrl-b.
    # Those lines carry the shortcut and optional description as written
    # in the exercise (e.g. "Ctrl-b c       new window").
    shortcuts="$(awk '
      /^```text/ { in_block=1; next }
      /^```/     { in_block=0; next }
      in_block && /^Ctrl-b/ { print "  " $0 }
    ' "${local_f}")"

    if [[ -n "${shortcuts}" ]]; then
      echo
      echo "${title}"
      echo "${shortcuts}"
    fi
  done

  echo
  exit 0
fi

# ── subcommand: menu ──────────────────────────────────────────────────────

if [[ "${1:-}" == "menu" ]]; then
  menu_items=""
  for (( n=1; n<=TOTAL_EXERCISES; n++ )); do
    printf -v p "%02d" "${n}"
    f="${EXERCISE_DIR}/day-${p}.md"
    [[ -f "${f}" ]] || continue
    title="$(grep -m1 '^# ' "${f}" | sed 's/^# //')"
    menu_items+="${p}  ${title}"$'\n'
  done

  if command -v fzf >/dev/null 2>&1; then
    selection="$(printf '%s' "${menu_items}" \
      | fzf --prompt='exercise > ' --height=40% --reverse)"
  else
    echo "Select an exercise:"
    IFS=$'\n' read -r -d '' -a menu_arr <<< "${menu_items}" || true
    select selection in "${menu_arr[@]}"; do
      [[ -n "${selection}" ]] && break
    done
  fi

  [[ -z "${selection}" ]] && exit 0
  chosen_day="$(echo "${selection}" | awk '{print $1}')"
  exec "$0" "$(( 10#${chosen_day} ))"
fi

# ── subcommand: done ───────────────────────────────────────────────────────

if [[ "${1:-}" == "done" ]]; then
  if [[ -f "${CURRENT_FILE}" ]]; then
    DAY_PADDED="$(cat "${CURRENT_FILE}")"
    DAY=$(( 10#${DAY_PADDED} ))
  else
    DAY="$(_current_day)"
    printf -v DAY_PADDED "%02d" "${DAY}"
  fi
  if [[ "$(_today_status "${DAY_PADDED}")" == "completed" ]]; then
    echo "Day ${DAY_PADDED} already marked done today."
  else
    _log_append "$(_today)" "${DAY_PADDED}" "completed"
    _srs_update "${DAY_PADDED}" 1
    STREAK="$(_streak)"
    printf "%s Day %s marked as completed\n" "${IC_CHECK}" "${DAY_PADDED}"
    if [[ "${DAY_PADDED}" == "20" ]] && [[ -f "${LOG_DIR}/time_start" ]]; then
      _ts_start="$(cat "${LOG_DIR}/time_start")"
      _ts_end="$(date +%s)"
      _elapsed=$(( _ts_end - _ts_start ))
      rm -f "${LOG_DIR}/time_start"
      _mins=$(( _elapsed / 60 ))
      _secs=$(( _elapsed % 60 ))
      if [[ "${_elapsed}" -le 300 ]]; then
        printf "%s Completed in %dm %02ds  (target: < 5m)\n" "${IC_TIMER}" "${_mins}" "${_secs}"
      else
        _over=$(( _elapsed - 300 ))
        printf "%s Completed in %dm %02ds  (target: < 5m — over by %ds)\n" \
          "${IC_TIMER}" "${_mins}" "${_secs}" "${_over}"
      fi
    fi
    PENDING="$(_srs_reviews_pending)"
    if [[ "${PENDING}" -gt 0 ]]; then
      printf "%s %d review(s) still due — run \`tmux-trainer\` to continue\n" \
        "${IC_BOOKS}" "${PENDING}"
    fi
    if [[ "${STREAK}" -gt 0 ]]; then
      if [[ "${_NARROW}" -eq 1 ]]; then
        printf "%s %d-day streak\n" "${IC_FIRE}" "${STREAK}"
      else
        printf "%s %d-day streak  ·  %s\n" "${IC_FIRE}" "${STREAK}" "$(_week_bar)"
      fi
    elif [[ "${_NARROW}" -eq 0 ]]; then
      echo "$(_week_bar)"
    fi
    _check_badges
  fi
  exit 0
fi

# ── subcommand: skip ───────────────────────────────────────────────────────

if [[ "${1:-}" == "skip" ]]; then
  if [[ -n "${2:-}" ]] && [[ "${2}" =~ ^[0-9]+$ ]]; then
    printf -v DAY_PADDED "%02d" "${2}"
  elif [[ -f "${CURRENT_FILE}" ]]; then
    DAY_PADDED="$(cat "${CURRENT_FILE}")"
  else
    printf -v DAY_PADDED "%02d" "$(_current_day)"
  fi
  _log_append "$(_today)" "${DAY_PADDED}" "skipped"
  _srs_update "${DAY_PADDED}" 0
  printf "%s Day %s skipped — queued for review tomorrow\n" "${IC_CROSS}" "${DAY_PADDED}"
  exit 0
fi

# ── subcommand: --tag ─────────────────────────────────────────────────────

if [[ "${1:-}" == "--tag" ]]; then
  TAG_FILTER="${2:-}"
  if [[ -z "${TAG_FILTER}" ]]; then
    echo "Usage: tmux-trainer --tag <name>" >&2; exit 1
  fi

  tag_items=""
  for (( _n=1; _n<=TOTAL_EXERCISES; _n++ )); do
    printf -v _p "%02d" "${_n}"
    _f="${EXERCISE_DIR}/day-${_p}.md"
    [[ -f "${_f}" ]] || continue
    _tags="$(grep -m1 '^tags:' "${_f}" | sed 's/^tags:[[:space:]]*//')"
    if echo "${_tags}" | grep -qw "${TAG_FILTER}"; then
      _title="$(grep -m1 '^# ' "${_f}" | sed 's/^# //')"
      tag_items+="${_p}  ${_title}"$'\n'
    fi
  done

  if [[ -z "${tag_items}" ]]; then
    printf "No exercises tagged '%s'\n" "${TAG_FILTER}" >&2; exit 1
  fi

  _tag_count="$(printf '%s' "${tag_items}" | grep -c .)"
  if [[ "${_tag_count}" -eq 1 ]]; then
    _chosen="$(printf '%s' "${tag_items}" | awk '{print $1}')"
    exec "$0" "$(( 10#${_chosen} ))"
  fi

  if command -v fzf >/dev/null 2>&1; then
    selection="$(printf '%s' "${tag_items}" \
      | fzf --prompt="[${TAG_FILTER}] > " --height=40% --reverse)"
  else
    echo "Exercises tagged '${TAG_FILTER}':"
    IFS=$'\n' read -r -d '' -a _tag_arr <<< "${tag_items}" || true
    select selection in "${_tag_arr[@]}"; do
      [[ -n "${selection}" ]] && break
    done
  fi
  [[ -z "${selection}" ]] && exit 0
  _chosen="$(echo "${selection}" | awk '{print $1}')"
  exec "$0" "$(( 10#${_chosen} ))"
fi

# ── select exercise ────────────────────────────────────────────────────────

SRS_REVIEW=""

if [[ $# -gt 0 ]]; then
  DAY="$1"
else
  DUE_LIST="$(_srs_due_list)"
  if [[ -n "${DUE_LIST}" ]]; then
    FIRST_DUE="$(echo "${DUE_LIST}" | head -1)"
    DAY=$(( 10#${FIRST_DUE} ))
    SRS_REVIEW="1"
  else
    DAY="$(_current_day)"
  fi
fi

if [[ "${DAY}" -lt 1 || "${DAY}" -gt "${TOTAL_EXERCISES}" ]]; then
  echo "Day must be between 1 and ${TOTAL_EXERCISES}" >&2
  exit 1
fi

printf -v DAY_PADDED "%02d" "${DAY}"
EXERCISE="${EXERCISE_DIR}/day-${DAY_PADDED}.md"

if [[ ! -f "${EXERCISE}" ]]; then
  echo "Exercise not found: ${EXERCISE}" >&2
  exit 1
fi

# ── temp copy (vimtutor pattern) ───────────────────────────────────────────
# Copy to /tmp so annotations don't dirty the repo.
# Refreshed only when the source file is newer than the copy.

TEMP_EXERCISE="/tmp/tmux-trainer-day-${DAY_PADDED}.md"
if [[ ! -f "${TEMP_EXERCISE}" ]] || [[ "${EXERCISE}" -nt "${TEMP_EXERCISE}" ]]; then
  cp "${EXERCISE}" "${TEMP_EXERCISE}"
fi

# Record which exercise is active so done/skip operate on the right one
_ensure_log
echo "${DAY_PADDED}" > "${CURRENT_FILE}"

# Timed drill: record start time when day 20 opens
if [[ "${DAY_PADDED}" == "20" ]]; then
  date +%s > "${LOG_DIR}/time_start"
fi

# ── notification ──────────────────────────────────────────────────────────

TITLE="$(grep -m1 '^# ' "${EXERCISE}" | sed 's/^# //')"
SUMMARY="$(grep -m1 '^Goal:' "${EXERCISE}" | sed 's/^Goal:[[:space:]]*//')"
NOTIFICATION="${SUMMARY:+${SUMMARY} · }Run: tmux-trainer"

if command -v osascript >/dev/null 2>&1; then
  osascript <<EOF
display notification "${NOTIFICATION}" with title "tmux trainer" subtitle "${TITLE}"
EOF
elif command -v notify-send >/dev/null 2>&1; then
  notify-send "tmux trainer — ${TITLE}" "${NOTIFICATION}"
fi

# ── display ────────────────────────────────────────────────────────────────

echo
echo "=== tmux trainer ==="
echo "${TITLE}"
echo

STREAK="$(_streak)"
PENDING="$(_srs_reviews_pending)"

if [[ "${PENDING}" -gt 10 ]]; then
  printf "%s %d reviews due — consider a catch-up session first.\n" "${IC_WARN}" "${PENDING}"
  echo
fi

if [[ -n "${SRS_REVIEW}" ]]; then
  srs_reps="$(awk -v p="${DAY_PADDED}" '$1==p{print $3}' "${SRS_FILE}" 2>/dev/null)"
  srs_reps="${srs_reps:-0}"
  srs_cur="${SRS_INTERVALS[$(( srs_reps < 4 ? srs_reps : 3 ))]}"
  srs_next_idx=$(( srs_reps < 3 ? srs_reps + 1 : 3 ))
  srs_next="${SRS_INTERVALS[${srs_next_idx}]}"
  printf "%s SRS review (%d due)  ·  interval %dd -> %dd on pass\n" \
    "${IC_BOOKS}" "${PENDING}" "${srs_cur}" "${srs_next}"
elif [[ "${PENDING}" -gt 0 ]]; then
  printf "%s %d review(s) due — run \`tmux-trainer\` after this one\n" \
    "${IC_BOOKS}" "${PENDING}"
fi

if [[ "${STREAK}" -gt 0 ]]; then
  if [[ "${_NARROW}" -eq 1 ]]; then
    printf "%s %d-day streak\n" "${IC_FIRE}" "${STREAK}"
  else
    printf "%s %d-day streak  ·  %s\n" "${IC_FIRE}" "${STREAK}" "$(_week_bar)"
  fi
elif [[ "${_NARROW}" -eq 0 ]]; then
  echo "$(_week_bar)"
fi

echo
cat "${TEMP_EXERCISE}"
echo

STATUS="$(_today_status "${DAY_PADDED}")"
printf "  → annotate freely: %s\n" "${TEMP_EXERCISE}"
if [[ "${STATUS}" != "completed" ]]; then
  if [[ -n "${SRS_REVIEW}" ]]; then
    echo "  → \`tmux-trainer done\` to pass  ·  \`tmux-trainer skip\` to re-queue"
  else
    echo "  → \`tmux-trainer done\` when finished  ·  \`tmux-trainer skip\` to queue for later"
  fi
fi
echo

# ── iTerm2 integration ─────────────────────────────────────────────────────

if [[ "${TMUX_TRAINER_OPEN_ITERM:-0}" == "1" ]] && [[ -d "/Applications/iTerm.app" ]]; then
  osascript \
    -e 'tell application "iTerm"' \
    -e '  activate' \
    -e '  create window with default profile' \
    -e '  tell current session of current window' \
    -e "    write text \"cd '${ROOT_DIR}' && cat '${TEMP_EXERCISE}'\"" \
    -e '  end tell' \
    -e 'end tell'
fi

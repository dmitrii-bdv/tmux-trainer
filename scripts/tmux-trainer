#!/usr/bin/env bash
# tmux-trainer — Copyright (c) 2026 Dmitrii Bedov
# Licensed under the PolyForm Noncommercial License 1.0.0 (see LICENSE).
# Commercial use requires permission: dmitrii@bedov.ch
#
# Thin entry point: resolves the install root, loads lib/, and dispatches.
set -euo pipefail

_src="${BASH_SOURCE[0]}"
while [[ -L "${_src}" ]]; do
  _dir="$(cd -P "$(dirname "${_src}")" && pwd)"
  _src="$(readlink "${_src}")"
  [[ "${_src}" != /* ]] && _src="${_dir}/${_src}"
done
ROOT_DIR="$(cd "$(dirname "${_src}")/.." && pwd)"
unset _src _dir

# lib/ files are linted on their own; their paths depend on ROOT_DIR.
# shellcheck disable=SC1091
source "${ROOT_DIR}/lib/config.sh"
source "${ROOT_DIR}/lib/dates.sh"
source "${ROOT_DIR}/lib/catalog.sh"
source "${ROOT_DIR}/lib/state.sh"
source "${ROOT_DIR}/lib/srs.sh"
source "${ROOT_DIR}/lib/assert.sh"
source "${ROOT_DIR}/lib/notify.sh"
source "${ROOT_DIR}/lib/help.sh"
for _cmd_file in "${ROOT_DIR}"/lib/commands/*.sh; do
  # shellcheck disable=SC1090  # command files are discovered at runtime
  source "${_cmd_file}"
done
unset _cmd_file

# Aliases.
case "${1:-}" in
  r)           set -- review ;;
  m)           set -- menu ;;
  d)           set -- "done" ;;
  s)           set -- skip "${@:2}" ;;
  c)           set -- check "${@:2}" ;;
  h|-h|--help) set -- help ;;
esac

case "${1:-}" in
  "")              cmd_show ;;
  help)            cmd_help ;;
  review)          cmd_review ;;
  check)           shift; cmd_check "$@" ;;
  cheat)           shift; cmd_cheat "$@" ;;
  menu)            cmd_menu ;;
  done)            cmd_done ;;
  skip)            shift; cmd_skip "$@" ;;
  --tag)           shift; cmd_tag "$@" ;;
  lint)            cmd_lint ;;
  --version)       echo "tmux-trainer ${TMUX_TRAINER_VERSION}" ;;
  --man-install)   cmd_man_install ;;
  --list-days)     _existing_pads | sed 's/^0*//' ;;
  --list-tags)     _all_tags ;;
  *)               cmd_show "$@" ;;
esac

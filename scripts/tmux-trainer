#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EXERCISE_DIR="${ROOT_DIR}/exercises"

if [[ $# -gt 0 ]]; then
  DAY="$1"
else
  # Monday=1 ... Friday=5. Weekends fall back to day 1.
  DAY="$(date +%u)"
  if [[ "${DAY}" -gt 5 ]]; then
    DAY=1
  fi
fi

printf -v DAY_PADDED "%02d" "${DAY}"
EXERCISE="${EXERCISE_DIR}/day-${DAY_PADDED}.md"

if [[ ! -f "${EXERCISE}" ]]; then
  echo "Exercise not found: ${EXERCISE}" >&2
  exit 1
fi

TITLE="$(grep -m1 '^# ' "${EXERCISE}" | sed 's/^# //')"
SUMMARY="$(grep -m1 '^Goal:' "${EXERCISE}" | sed 's/^Goal:[[:space:]]*//')"

if command -v osascript >/dev/null 2>&1; then
  osascript -e "display notification \"${SUMMARY:-Open today's tmux exercise}\" with title \"tmux trainer\" subtitle \"${TITLE}\""
fi

echo
echo "=== tmux trainer ==="
echo "${TITLE}"
echo
cat "${EXERCISE}"
echo

# Optional: open iTerm2 and show the exercise.
# Set TMUX_TRAINER_OPEN_ITERM=1 in your shell environment to enable.
if [[ "${TMUX_TRAINER_OPEN_ITERM:-0}" == "1" ]] && [[ -d "/Applications/iTerm.app" ]]; then
  osascript <<EOF
tell application "iTerm"
  activate
  create window with default profile
  tell current session of current window
    write text "cd '${ROOT_DIR}' && cat '${EXERCISE}'"
  end tell
end tell
EOF
fi
